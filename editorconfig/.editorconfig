root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.{js,jsx,ts,tsx,yml,yaml,json,nim}]
indent_size = 2

[*.lua]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 8

[*.md]
max_line_length = 0
trim_trailing_whitespace = false

[COMMIT_EDITMSG]
max_line_length = 0

# Layout belongs to CSharpier (it reads indent and max_line_length above), so no csharp_* spacing/newline options here.
[*.cs]
dotnet_sort_system_directives_first = true

# CSharpier joins using groups, a blank line between them would flip-flop with dotnet format
dotnet_separate_import_directive_groups = false

# Formatting diagnostics would flag CSharpier's layout
dotnet_diagnostic.IDE0055.severity = none

# Namespace does not match file path crashes dotnet format
dotnet_diagnostic.IDE0130.severity = none

# Unnecessary using
dotnet_diagnostic.IDE0005.severity = error

# Name can be simplified
dotnet_diagnostic.IDE0001.severity = error

# Roslynator: everything enabled by default becomes a warning, minus these
dotnet_analyzer_diagnostic.category-roslynator.severity = warning
dotnet_diagnostic.RCS1130.severity = none
dotnet_diagnostic.RCS1138.severity = none
dotnet_diagnostic.RCS1139.severity = none
dotnet_diagnostic.RCS1141.severity = none
dotnet_diagnostic.RCS1142.severity = none

# Autofixes that break or fight conventions under dotnet format --severity info
# Fix moves files between folders, dotnet format aborts
dotnet_diagnostic.IDE0130.severity = none
# Fix marks methods static but misses instance call sites
dotnet_diagnostic.CA1822.severity = none
# Fix invents PascalCase locals from tuple names
dotnet_diagnostic.IDE0042.severity = none
