#!/bin/bash
# Restrictive bubblewrap sandbox for running pi (and anything else) in the cwd.
# Usage: sandbox [command...]    (default: $SHELL)
#        sandbox --check         assert the sandbox boundary is actually on

set -euo pipefail
HERE="$(realpath .)"
[[ "$HERE" != "$HOME" ]] || { echo "sandbox: refusing to bind \$HOME as the workspace" >&2; exit 1; }

bwrap_args=(
    # Read-only system: enough for the shell and necessary tools
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/bin /sbin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64

    # Home: everything visible and writable via overlay, writes ephemeral
    --overlay-src "$HOME"
    --tmp-overlay "$HOME"
    --tmpfs "$HOME/.ssh"
    --tmpfs "$HOME/.gnupg"

    # Tool state: everything visible and writable, writes persist
    --bind "$HOME/.pi" "$HOME/.pi"

    # Project: everything visible and writable, writes persist
    --bind "$HERE" "$HERE"
    --ro-bind-try "$HERE/.git" "$HERE/.git"

    --proc /proc
    --dev /dev
    --tmpfs /tmp

    --unshare-all
    --unshare-user         # required for --disable-userns to work
    --share-net            # we want network access
    --disable-userns       # no nested user namespaces from inside
    --hostname sandbox
    --die-with-parent

    --setenv PS1 "sandbox$ "
)

if [[ ${1:-} == --check ]]; then
    exec bwrap "${bwrap_args[@]}" bash -c '
        set -e
        test -z "$(ls -A "$HOME/.ssh" 2>/dev/null)" && test -z "$(ls -A "$HOME/.gnupg" 2>/dev/null)"  # secrets masked
        test ! -e /var                                                                                # bwrap view is active
        test -r "$HOME/.gitconfig"                                                                    # real home config visible
        touch "$HOME/.sandbox-home-probe" && rm "$HOME/.sandbox-home-probe"                           # home writable (ephemerally)
        test -x /usr/bin/git                                                                          # system tools present
        touch .sandbox-check && rm .sandbox-check                                                     # cwd writable
        echo "sandbox ok"'
fi

exec bwrap "${bwrap_args[@]}" "${@:-${SHELL:-/bin/bash}}"
