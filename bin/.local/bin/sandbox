#!/bin/bash
# Restrictive bubblewrap sandbox for running pi (and anything else) in the cwd.
# Usage: sandbox [command...]    (default: $SHELL)
#        sandbox --check         assert the sandbox boundary is actually on

set -euo pipefail
HERE="$(realpath .)"
[[ "$HERE" != "$HOME" ]] || { echo "sandbox: refusing to bind \$HOME as the workspace" >&2; exit 1; }

bwrap_args=(
    # Read-only system: enough for the shell, node, git, ripgrep (Arch merged-usr)
    --ro-bind /usr /usr
    --ro-bind /etc /etc
    --symlink usr/bin /bin
    --symlink usr/bin /sbin
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64

    # Ephemeral home
    --tmpfs "$HOME"
    --bind "$HOME/.pi" "$HOME/.pi"                          # pi
    --bind "$HOME/.agents" "$HOME/.agents"                  # agents
    --ro-bind "$HOME/.gitconfig" "$HOME/.gitconfig"         # git identity + aliases
    --ro-bind-try "$HOME/.gitconfig.local" "$HOME/.gitconfig.local"
    --ro-bind "$HOME/.config/gh" "$HOME/.config/gh"         # gh auth
    --ro-bind "$HOME/.npm-global" "$HOME/.npm-global"       # pi + global node binaries

    # Project workspace
    --bind "$HERE" "$HERE"                                  # the project
    --ro-bind-try "$HERE/.git" "$HERE/.git"                 # block commits

    --proc /proc
    --dev /dev
    --tmpfs /tmp

    --unshare-all
    --unshare-user
    --share-net
    --disable-userns
    --hostname sandbox
    --die-with-parent

    --setenv PS1 "sandbox$ "
)

if [[ ${1:-} == --check ]]; then
    exec bwrap "${bwrap_args[@]}" bash -c '
        set -e
        test ! -e "$HOME/.ssh" && test ! -e "$HOME/.gnupg"                 # host secrets hidden
        test ! -e /var                                                     # bwrap view is active
        test -x /usr/bin/git                                               # system tools present
        touch "$HOME/.pi/.sandbox-check" && rm "$HOME/.pi/.sandbox-check"  # pi state rw
        touch .sandbox-check && rm .sandbox-check                          # cwd writable
        echo "sandbox ok"'
fi

exec bwrap "${bwrap_args[@]}" "${@:-${SHELL:-/bin/bash}}"
