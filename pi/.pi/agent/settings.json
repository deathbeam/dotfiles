{
  "defaultModel": "expensive",
  "defaultProvider": "combo",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.6.0",
  "defaultThinkingLevel": "high",
  "steeringMode": "all",
  "followUpMode": "all",
  "defaultProjectTrust": "always",
  "theme": "system",
  "quietStartup": true,
  "outputPad": 1,
  "editorPaddingX": 1,
  "tuiMode": "fullscreen",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "shellCommandPrefix": "export EDITOR=true VISUAL=true GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_MERGE_AUTOEDIT=no PAGER=cat MANPAGER=cat GIT_PAGER=cat GH_PAGER=cat AWS_PAGER= SYSTEMD_PAGER=cat\nexport GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never GCM_INTERACTIVE=never GH_PROMPT_DISABLED=1 DEBIAN_FRONTEND=noninteractive PIP_NO_INPUT=1 npm_config_yes=true",
  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp"
  ],
  "packages": [
    "npm:pi-context-view",
    "npm:@dietrichgebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@deathbeam/pi-inferhub",
    "npm:@deathbeam/pi-opencode",
    "npm:@deathbeam/pi-combos",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-context",
    "npm:@deathbeam/pi-images",
    "npm:@deathbeam/pi-usage"
  ],
  "enabledModels": [
    "combo/cheap",
    "combo/balanced",
    "combo/expensive"
  ],
  "combos": {
    "cheap": [
      "mistral/deepseek-v4-1-flash-1017",
      "opencode-go/deepseek-v4.1-flash"
    ],
    "balanced": [
      "inferhub/zai/glm-5.4"
    ],
    "expensive": [
      "anthropic/claude-opus-5-5",
      "inferhub/claude-opus-5.5"
    ]
  },
  "delegate": {
    "models": {
      "cheap": "combo/cheap:low",
      "balanced": "combo/cheap:high",
      "strong": "combo/balanced:max"
    }
  },
  "images": {
    "vision": "combo/cheap",
    "generate": "inferhub/gemini-3.1-flash-image"
  },
  "context": {
    "compaction": "combo/cheap:high"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@gotgenes/pi-anthropic-auth\",\"scope\":\"user\"}": "3.6.0",
    "{\"source\":\"npm:pi-context-view\",\"scope\":\"user\"}": "0.8.4"
  }
}
