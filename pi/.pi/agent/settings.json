{
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "anthropic",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.3.0",

  "defaultThinkingLevel": "high",
  "cacheWarming": "idle",

  "steeringMode": "all",
  "followUpMode": "all",
  "defaultProjectTrust": "always",

  "theme": "system",
  "quietStartup": true,
  "outputPad": 1,
  "editorPaddingX": 0,
  "tuiMode": "regular",
  "warnings": {
    "anthropicExtraUsage": false
  },

  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp"
  ],

  "packages": [
    "npm:pi-free",
    "npm:pi-context-view",
    "npm:@dietrichgebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@deathbeam/pi-inferhub",
    "npm:@deathbeam/pi-surplus",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-images",
    "npm:@deathbeam/pi-usage"
  ],

  "enabledModels": [
    "inferhub/glm-5.3-flash",
    "inferhub/glm-5.3",
    "inferhub/claude-opus-5.5",
    "surplus/glm-5.3-flash",
    "surplus/glm-5.3",
    "surplus/claude-opus-5.5",
    "anthropic/claude-haiku-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5"
  ],

  "delegate": {
    "models": {
      "cheap": "opencode-free/deepseek-v4.1-flash-free:low",
      "balanced": "inferhub/glm-5.3:high",
      "strong": "inferhub/glm-5.3:high"
    }
  },

  "images": {
    "vision": "opencode-free/deepseek-v4.1-flash-free",
    "generate": "inferhub/gemini-3.1-flash-image"
  },

  "archive": {
    "compaction": "opencode-free/deepseek-v4.1-flash-free:high"
  }
}
