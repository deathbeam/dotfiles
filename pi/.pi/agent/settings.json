{
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "anthropic",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.4.0",
  "defaultThinkingLevel": "high",
  "steeringMode": "all",
  "followUpMode": "all",
  "defaultProjectTrust": "always",
  "theme": "system",
  "quietStartup": true,
  "outputPad": 1,
  "editorPaddingX": 0,
  "tuiMode": "regular",
  "warnings": {
    "anthropicExtraUsage": false
  },

  "shellCommandPrefix": "export EDITOR=true VISUAL=true GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_MERGE_AUTOEDIT=no PAGER=cat MANPAGER=cat GIT_PAGER=cat GH_PAGER=cat AWS_PAGER= SYSTEMD_PAGER=cat\nexport GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never GCM_INTERACTIVE=never GH_PROMPT_DISABLED=1 DEBIAN_FRONTEND=noninteractive PIP_NO_INPUT=1 npm_config_yes=true",

  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp"
  ],

  "packages": [
    "npm:pi-free",
    "npm:pi-context-view",
    "npm:@dietrichgebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@deathbeam/pi-inferhub",
    "npm:@deathbeam/pi-surplus",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-images",
    "npm:@deathbeam/pi-usage"
  ],

  "enabledModels": [
    "inferhub/deepseek-v4.1-flash-1017",
    "inferhub/glm-5.3",
    "inferhub/kimi-k3.1-pro",
    "inferhub/claude-opus-5.5",
    "anthropic/claude-haiku-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5"
  ],

  "delegate": {
    "models": {
      "cheap": "inferhub/deepseek-v4.1-flash-1017:low",
      "balanced": "inferhub/glm-5.3:high",
      "strong": "inferhub/kimi-k3.1-pro:max"
    }
  },

  "images": {
    "vision": "opencode-free/deepseek-v4.1-flash-free",
    "generate": "inferhub/gemini-3.1-flash-image"
  },

  "archive": {
    "compaction": "inferhub/deepseek-v4.1-flash-1017:high"
  }
}
