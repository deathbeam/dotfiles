{
  "defaultModel": "deepseek-v4.1-flash",
  "defaultProvider": "opencode-go",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "0.86.1",
  "packages": [
    "npm:pi-terminal-theme",
    "https://github.com/nicobailon/pi-subagents"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "theme": "terminal",
  "images": {
    "blockImages": false
  },
  "defaultThinkingLevel": "max",
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": false,
  "quietStartup": false,
  "editorPaddingX": 0,
  "compaction": {
    "enabled": true
  },
  "defaultProjectTrust": "always",
  "subagents": {
    "defaultExtensions": [
      "/home/deathbeam/.pi/agent/extensions/inferhub",
      "/home/deathbeam/.pi/agent/extensions/pi-hashline-edit"
    ]
  },
  "readseek": {
    "overrideTools": [
      "read",
      "edit",
      "write",
      "grep"
    ],
    "syntaxValidation": "warn",
    "display": {
      "grep": "compact",
      "edit": "expanded",
      "write": "expanded"
    }
  },
  "enabledModels": [
    "inferhub/glm-5.3",
    "inferhub/glm-5.3-flash",
    "opencode-go/deepseek-v4.1-flash",
    "inferhub/gpt-5.6-sol"
  ]
}