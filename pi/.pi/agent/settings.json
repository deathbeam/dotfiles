{
  "defaultModel": "claude-opus-5-5",
  "defaultProvider": "anthropic",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "npm:pi-free",
    "npm:pi-context-view",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@deathbeam/pi-inferhub",
    "npm:@deathbeam/pi-surplus",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-images",
    "npm:@deathbeam/pi-usage"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "theme": "system",
  "defaultThinkingLevel": "high",
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": false,
  "quietStartup": true,
  "editorPaddingX": 0,
  "compaction": {
    "enabled": true
  },
  "defaultProjectTrust": "always",
  "delegate": {
    "models": {
      "cheap": "anthropic/claude-haiku-5-5:low",
      "balanced": "inferhub/glm-5.3:high",
      "strong": "inferhub/claude-opus-5.5:high"
    }
  },
  "images": {
    "vision": "anthropic/claude-haiku-5-5",
    "generate": "inferhub/gemini-3.1-flash-image"
  },
  "archive": {
    "compaction": "opencode-free/deepseek-v4.1-flash-free:high"
  },
  "enabledModels": [
    "inferhub/glm-5.3-flash",
    "inferhub/glm-5.3",
    "inferhub/claude-opus-5.5",
    "surplus/glm-5.3-flash",
    "surplus/glm-5.3",
    "surplus/claude-opus-5.5",
    "anthropic/claude-haiku-5-5",
    "anthropic/claude-sonnet-5-5",
    "anthropic/claude-opus-5-5"
  ],
  "outputPad": 1,
  "tuiMode": "regular",
  "warnings": {
    "anthropicExtraUsage": false
  }
}
