{
  "defaultModel": "zai-glm-5-3",
  "defaultProvider": "mistral",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.1.0",
  "packages": [
    "npm:pi-free",
    "npm:pi-context-view",
    "npm:pi-vision-handoff",
    "npm:@amaster.ai/pi-image-gen",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-inferhub"
  ],
  "terminal": {
    "showTerminalProgress": false
  },
  "theme": "system",
  "images": {
    "blockImages": false
  },
  "defaultThinkingLevel": "max",
  "steeringMode": "all",
  "followUpMode": "all",
  "hideThinkingBlock": false,
  "quietStartup": false,
  "editorPaddingX": 0,
  "compaction": {
    "enabled": false
  },
  "defaultProjectTrust": "always",
  "delegate": {
    "agentDirs": [
      "~/.agents/agents"
    ],
    "models": {
      "cheap": "inferhub/glm-5.3-flash",
      "balanced": "inferhub/glm-5.3",
      "strong": "inferhub/glm-5.3"
    }
  },
  "pi-image-gen": {
    "defaultModel": "cb/gemini-3.0-pro-image",
    "customProviders": {
      "inferhub": {
        "api": "openai",
        "baseUrl": "https://api.inferhub.dev/v1",
        "apiKey": "${INFERHUB_API_KEY}",
        "name": "InferHub",
        "models": [
          "cb/gpt-image-2",
          "cb/gemini-3.0-pro-image",
          "cb/gemini-3.1-flash-image",
          "cb/gemini-2.5-flash-image"
        ]
      }
    }
  },
  "enabledModels": [
    "opencode/mimo-v2.6-flash-free",
    "opencode/space-bunny-free",
    "inferhub/deepseek-v4.1-flash",
    "inferhub/glm-5.3-flash",
    "inferhub/glm-5.3",
    "inferhub/gpt-6.1-sol",
    "mistral/zai-glm-5-3"
  ],
  "outputPad": 1,
  "tuiMode": "regular"
}
