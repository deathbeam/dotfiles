{
  "defaultModel": "claude-opus-5.5",
  "defaultProvider": "github-copilot",
  "enableInstallTelemetry": false,
  "lastChangelogVersion": "1.1.0",

  "defaultThinkingLevel": "high",

  "steeringMode": "all",
  "followUpMode": "all",
  "defaultProjectTrust": "always",

  "theme": "system",
  "quietStartup": true,
  "outputPad": 1,
  "editorPaddingX": 0,
  "tuiMode": "regular",

  "shellCommandPrefix": "export EDITOR=true VISUAL=true GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_MERGE_AUTOEDIT=no PAGER=cat MANPAGER=cat GIT_PAGER=cat GH_PAGER=cat AWS_PAGER= SYSTEMD_PAGER=cat\nexport GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false SSH_ASKPASS_REQUIRE=never GCM_INTERACTIVE=never GH_PROMPT_DISABLED=1 DEBIAN_FRONTEND=noninteractive PIP_NO_INPUT=1 npm_config_yes=true",

  "extensions": [
    "-builtin:mcp",
    "-builtin:codemode",
    "-builtin:tool-search",
    "-builtin:llama.cpp"
  ],

  "packages": [
    "npm:pi-context-view",
    "npm:@dietrichgebert/ponytail",
    "npm:@deathbeam/pi-keenable",
    "npm:@deathbeam/pi-archive",
    "npm:@deathbeam/pi-delegate",
    "npm:@deathbeam/pi-hashline",
    "npm:@deathbeam/pi-images",
    "npm:@deathbeam/pi-usage"
  ],

  "enabledModels": [
    "github-copilot/claude-haiku-5.5",
    "github-copilot/claude-sonnet-5.5",
    "github-copilot/claude-opus-5.5",
    "github-copilot/gpt-6.1-sol"
  ],

  "delegate": {
    "models": {
      "cheap": "github-copilot/claude-haiku-5.5:low",
      "balanced": "github-copilot/gpt-6.1-sol:medium",
      "strong": "github-copilot/gpt-6.1-sol:high"
    }
  }
}
